{
  "name": "xue-tu-edu",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @edu/web --filter @edu/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @edu/web test:e2e",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @edu/api prisma:generate",
    "db:migrate": "pnpm --filter @edu/api prisma:migrate",
    "db:seed": "pnpm --filter @edu/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
